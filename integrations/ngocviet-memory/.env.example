# Copy this file to `.env` in this same directory and fill in real values.
# `.env` is gitignored — never commit it. See docs/security.md.
#
# This file is loaded two ways:
#   - docker compose variable substitution: run compose with
#     `docker compose --env-file ../.env ...` from the docker/ directory.
#   - the gateway container's own environment: docker/docker-compose.yml
#     sets `env_file: ../.env` on the gateway service.

# ---------------------------------------------------------------------------
# Mem0 (upstream self-hosted memory store)
# ---------------------------------------------------------------------------
# Set by docker-compose automatically to http://mem0:8000 for the gateway
# container; only needed here if you run the gateway outside docker-compose.
MEM0_API_URL=
# Admin/master key for Mem0. Lives ONLY in this .env and the gateway
# container's environment — never given to Hermes, OpenClaw, or anyone else.
MEM0_API_KEY=
MEM0_JWT_SECRET=
# Confirm the actual auth header/scheme against your pinned Mem0 commit's
# OpenAPI docs (server/main.py) before deploying; defaults assume
# `Authorization: Bearer <key>`.
MEM0_AUTH_HEADER=Authorization
MEM0_AUTH_SCHEME=Bearer

# Git ref of https://github.com/mem0ai/mem0 to vendor/build from. MUST be a
# full 40-char commit SHA you have personally verified — never a branch name,
# and never a tag copied from an untrusted source (including AI-generated
# summaries). See docs/deployment.md Phase 1.
MEM0_SOURCE_GIT_REF=
MEM0_SOURCE_DIR=../vendor/mem0

# Mem0's own LLM/embedder provider, used internally for memory extraction —
# separate from anything Hermes/OpenClaw use for their own conversations.
LLM_PROVIDER=
LLM_API_KEY=

# ---------------------------------------------------------------------------
# NgocViet Memory Gateway — per-client API keys (never shared between clients)
# ---------------------------------------------------------------------------
# MEMORY_GATEWAY_CLIENT_IDS is the extension point: this is the same stable
# API (docs/api-contract.md) that Hermes, OpenClaw, n8n, DeepSeek Harness,
# and Codex can all call — adding a new caller is a .env change only, never
# a code change. For each id in the list, set
# MEMORY_GATEWAY_API_KEY_<ID_UPPERCASE> (required) and optionally
# RATE_LIMIT_PER_MINUTE_<ID_UPPERCASE> (falls back to
# DEFAULT_RATE_LIMIT_PER_MINUTE). Generate each key independently, e.g.
# `openssl rand -hex 32` — never reuse one key across two clients.
MEMORY_GATEWAY_CLIENT_IDS=hermes,openclaw
DEFAULT_RATE_LIMIT_PER_MINUTE=60

MEMORY_GATEWAY_API_KEY_HERMES=
MEMORY_GATEWAY_API_KEY_OPENCLAW=
RATE_LIMIT_PER_MINUTE_HERMES=60
RATE_LIMIT_PER_MINUTE_OPENCLAW=60

# Example of adding a future client (uncomment + add "n8n" to
# MEMORY_GATEWAY_CLIENT_IDS above when actually onboarding it):
# MEMORY_GATEWAY_API_KEY_N8N=
# RATE_LIMIT_PER_MINUTE_N8N=60
# MEMORY_GATEWAY_API_KEY_DEEPSEEK_HARNESS=
# MEMORY_GATEWAY_API_KEY_CODEX=

NGOCVIET_APP_ID=ngocviet-ai-business-os
TEMPORARY_DEFAULT_TTL_SECONDS=604800
SEARCH_OVERFETCH_MULTIPLIER=3

# Confirm this port is free on the target server during the Phase 0 audit
# (see docs/server-audit-checklist.md) before changing the default.
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_BIND_PORT=8077

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL (backing store for Mem0; never accessed directly by Hermes/OpenClaw)
# ---------------------------------------------------------------------------
POSTGRES_DB=ngocviet_memory
POSTGRES_USER=
POSTGRES_PASSWORD=
